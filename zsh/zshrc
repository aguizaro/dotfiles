# Option+Left/Right word-jump (iTerm2 sends double-escape sequences for these,
# to stay unambiguous through tmux's escape-time handling). Bind both the CSI
# and SS3 forms since zle's application-cursor-keys mode (smkx) makes plain
# arrows send ESC O C/D instead of ESC [ C/D.
bindkey '\e\e[C' forward-word
bindkey '\e\e[D' backward-word
bindkey '\e\eOC' forward-word
bindkey '\e\eOD' backward-word

alias python='python3'
alias pip='pip3'
alias dotfiles='cd ~/Desktop/Projects/dotfiles'
alias ls='eza --icons --group-directories-first' # Use eza instead of ls for better visuals

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

export PATH="$HOME/mongodb/bin:$HOME/mongosh/bin:$PATH"

# envman
[ -s "$HOME/.config/envman/load.sh" ] && source "$HOME/.config/envman/load.sh"

# Antigravity
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# Update tmux pane title for the currently running command
preexec() {
  if [[ -n "$TMUX" ]]; then
    local cmd="$1"
    # shorten long commands for display
    if [[ ${#cmd} -gt 40 ]]; then
      cmd="${cmd[1,40]}..."
    fi
    tmux select-pane -T "$cmd"
  fi
}

# Reset the pane title back to zsh prompt after command ends
precmd() {
  if [[ -n "$TMUX" ]]; then
    tmux select-pane -T "zsh"
  fi
}
